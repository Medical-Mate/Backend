# docker-compose 로 컨테이너를 띄울 때 쓰는 값.
#
# 이 파일은 커밋된다. 실제 값을 여기 적지 말 것 — .env 에 넣는다.
# .env 는 .gitignore 에 걸려 있다.
#
# IDE/gradlew 로 로컬 실행할 때는 .env 가 아니라
# application-local.yml 을 쓴다 (Spring Boot 는 .env 를 스스로 읽지 않음).
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=change-me

# 로컬에서 5432가 다른 프로젝트에 물려 있으면 비어 있는 포트로 바꾼다.
# docker-compose 와 Spring 이 같은 값을 읽으므로 한 곳만 바꾸면 된다.
# DB_PORT=5434
#
# 앱을 컨테이너로 띄울 때는 DB 호스트가 localhost 가 아니라 compose 서비스명이다.
# DB_HOST=postgres

# JWT 서명 키. 32바이트 이상. 운영에서는 반드시 교체한다.
JWT_SECRET=change-me-to-a-long-random-string-32bytes+

# 카카오 개발자 콘솔 > 앱 설정 > 앱 키.
#
# 백엔드가 쓰는 카카오 값은 이 둘뿐이다. REST API 키·네이티브 앱 키·JavaScript 키는
# 앱(클라이언트)이 로그인할 때 쓰는 것이라 서버에 넣지 않는다.
#
# APP_ID 는 숫자다 (32자리 키들과 헷갈리지 말 것). 콘솔 주소창의
# /console/app/<숫자> 가 그 값이다. 비밀값이 아니다 — 카카오가 토큰 조회
# 응답에 그대로 실어준다.
#
# 비어 있으면 서버가 기동하지 않는다. 앱 ID 대조는 남의 앱에서 발급된 정상
# 카카오 토큰을 걸러내는 유일한 방어선인데, 없을 때 그냥 통과시키면 방어선이
# 꺼진 채로 로그인이 멀쩡히 성공해서 아무도 눈치채지 못한다.
KAKAO_APP_ID=

# Admin 키는 비밀값이다. 탈퇴 시 연결 끊기(unlink)에만 쓴다.
# 비워두면 unlink 를 건너뛰고 탈퇴 자체는 정상 동작한다.
#
# 여기 적지 말 것. .env 에 넣는다.
KAKAO_ADMIN_KEY=
