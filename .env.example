# docker-compose 로 컨테이너를 띄울 때 쓰는 값.
# 실제 값은 .env 에 넣고, .env 는 커밋하지 않는다.
#
# IDE/gradlew 로 로컬 실행할 때는 .env 가 아니라
# application-local.yml 을 쓴다 (Spring Boot 는 .env 를 스스로 읽지 않음).
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=change-me

# 로컬에서 5432가 다른 프로젝트에 물려 있으면 비어 있는 포트로 바꾼다.
# docker-compose 와 Spring 이 같은 값을 읽으므로 한 곳만 바꾸면 된다.
# DB_PORT=5434
#
# 앱을 컨테이너로 띄울 때는 DB 호스트가 localhost 가 아니라 compose 서비스명이다.
# DB_HOST=postgres

# JWT 서명 키. 32바이트 이상. 운영에서는 반드시 교체한다.
JWT_SECRET=change-me-to-a-long-random-string-32bytes+

# 카카오 개발자 콘솔에서 발급.
# APP_ID 가 비어 있으면 앱 ID 검증을 건너뛴다 — 운영에서는 반드시 채운다.
KAKAO_APP_ID=
KAKAO_ADMIN_KEY=
