# 운영 서버(Lightsail)의 deploy/.env 예시입니다.
#
# 실제 값이 든 .env 는 서버에만 두고 커밋하지 않습니다 (.gitignore).
# 이 파일에는 절대 진짜 값을 적지 마세요 — 예시만 남깁니다.

# ---------- 공개 주소 ----------
# Caddy 가 이 이름으로 인증서를 받습니다. 도메인이 없을 때는 고정 IP 를
# 하이픈으로 바꾼 sslip.io 주소(13-125-7-42.sslip.io)로도 됩니다.
PUBLIC_HOST=api.medicalmate.site


# ---------- DB ----------
POSTGRES_DB=jinryomate
POSTGRES_USER=jinryomate
# openssl rand -base64 24 로 만드세요.
POSTGRES_PASSWORD=CHANGE-ME

# ---------- 인증 ----------
# HS256 이라 32바이트 이상이어야 합니다. openssl rand -base64 48
# 이 값을 아는 사람은 아무 사용자의 토큰이든 위조할 수 있습니다.
JWT_SECRET=CHANGE-ME

# ---------- 카카오 ----------
# 앱 ID 는 비밀값이 아닙니다. 없으면 서버가 아예 뜨지 않습니다.
KAKAO_APP_ID=CHANGE-ME
# Admin 키는 비밀값입니다. 유출되면 남의 계정 연결을 끊을 수 있습니다.
KAKAO_ADMIN_KEY=CHANGE-ME

# ---------- 심평원 병원 검색 ----------
# 발급받은 문자열을 그대로 넣습니다. 디코딩해서 넣으면 결과가 조용히 0건입니다.
# 비우면 고정 목록으로 돕니다.
HIRA_SERVICE_KEY=

# ---------- Grafana (한시 — 심사 끝나면 지움) ----------
# 비면 grafana 컨테이너가 뜨지 않습니다. 절차는 docs/analytics-grafana.md.
GRAFANA_ADMIN_PASSWORD=CHANGE-ME
# grafana_ro DB 역할의 비밀번호. deploy/grafana/provisioning 의 데이터소스가 읽습니다.
ANALYTICS_DB_PASSWORD=CHANGE-ME

# ---------- AI ----------
# AI 이미지 주소. 준비되면 바꾸세요.
AI_IMAGE=ghcr.io/medical-mate/ai:latest

# 백엔드가 보낸 요청이 맞는지 AI 가 확인하는 서명 키입니다. 백엔드·AI 가 같은 값을 읽습니다.
# MEDIMATE_REQUIRE_HMAC=1 이면 비었을 때 AI 가 뜨지 않습니다 — 무검증으로 조용히 도는 것을 막습니다.
# openssl rand -base64 32
MEDIMATE_HMAC_SECRET=CHANGE-ME
MEDIMATE_REQUIRE_HMAC=1

# ---------- AI 운영 스위치 ----------
# 하루 LLM 지출 상한(USD). 비우면 무제한입니다.
MEDIMATE_DAILY_BUDGET_USD=12
# 상한 카운터를 둘 파일. compose 의 ai-state 볼륨 안이라 배포해도 남습니다.
MEDIMATE_BUDGET_STATE_FILE=/var/lib/medimate/budget.json
# 진료 후 카드의 "지침" 축. 한 번 켜면 심사 끝까지 유지합니다(compose 주석 참고).
MEDIMATE_LIFESTYLE_AXIS=1
MEDIMATE_ENV=prod

# ---------- Langfuse (AI 트레이싱) ----------
# 키가 비면 트레이싱이 꺼질 뿐 AI 는 정상으로 돕니다.
# 본문 수집(MEDIMATE_TRACE_CONTENT)은 여기 없습니다 — compose 주석 참고.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------- LLM 공급자 : Bedrock Nova Pro 로 확정 (2026-09-11) ----------
# Claude Sonnet 5 는 목록에는 뜨지만 신규 계정 등급 제한으로 실제 호출이 거부됩니다
# (AccessDeniedException). list-foundation-models 는 카탈로그 조회일 뿐이라
# 접근 권한과 다릅니다 — 반드시 실제로 InvokeModel 을 해보고 확인하세요.
#
# Nova Pro 는 같은 프롬프트 실측에서 기존 모델보다 지연 2.6배 빠르고 비용 1/3 입니다.
MEDIMATE_PROVIDER=bedrock
MEDIMATE_MODEL=apac.amazon.nova-pro-v1:0

# bedrock:InvokeModel 하나만 가진 전용 IAM 사용자의 키입니다.
# Lightsail 은 인스턴스에 IAM 역할을 붙일 수 없어 키를 둡니다.
# boto3 는 환경변수를 IAM 역할과 똑같이 취급하므로 AI 코드는 바뀌지 않습니다.
#
# 다른 AWS 권한을 절대 주지 마세요 — 유출 시 피해 범위가 여기서 갈립니다.
#
# 리전은 Claude 가 있는 곳이어야 합니다. 서울에 없으면 다른 리전을 넣습니다 —
# AI 문서상 LLM 왕복이 지연을 지배해서 리전 간 차이는 묻힙니다.
BEDROCK_REGION=ap-northeast-2
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# ---------- OpenAI (폐기된 경로. 되돌릴 때만) ----------
# 크레딧이 소진되면 단가가 싼 이쪽이 다시 유리해집니다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
