# Caddy 는 인증서를 스스로 발급·갱신한다. certbot 이나 크론이 필요 없다.
#
# {$PUBLIC_HOST} 는 sslip.io 주소다. 예: 1-2-3-4.sslip.io
# 그 호스트명이 1.2.3.4 로 해석되므로 도메인을 사지 않아도 Let's Encrypt 인증서가 나온다.
# 카카오 웹훅이 HTTPS 를 요구하는데 이걸로 충족된다.

{
	# 관리 API 를 밖으로 열지 않는다.
	admin off
}

# ACME 연락처 주소는 여기에 두지 않는다.
#
# email {$ACME_EMAIL} 로 두면 그 변수가 비었을 때 지시어에 인자가 없어져
# Caddyfile 파싱이 통째로 실패한다 — 컨테이너가 재시작만 반복하고 HTTPS 가 안 뜬다.
# Caddyfile 에는 "값이 있으면 쓰고 없으면 건너뛰기" 문법이 없다.
#
# 주소 없이도 인증서는 정상 발급된다(익명 발급). 만료 경고 메일을 받고 싶으면
# 아래 한 줄을 위 블록 안에 직접 적는다.
#
#     email you@example.com

{$PUBLIC_HOST} {
	encode zstd gzip

	# 뒤로는 평문이다. 같은 호스트의 Docker 네트워크 안이라 인터넷을 타지 않는다.
	reverse_proxy backend:8080 {
		# 백엔드가 실제 클라이언트 IP 를 알아야 로그가 의미를 가진다.
		header_up X-Real-IP {remote_host}

		# AI 카드 생성이 60초까지 걸린다. 기본값으로 두면 Caddy 가 먼저 끊는다.
		transport http {
			response_header_timeout 90s
		}
	}

	log {
		output stdout
		format console
		# 증상 텍스트가 URL 에 실리지 않지만, 쿼리스트링까지 남기지는 않는다.
	}
}
