# 이 파일을 application-local.yml 로 복사해서 쓰세요. 복사본은 커밋되지 않습니다.
# 실행: ./gradlew bootRun --args='--spring.profiles.active=local'
#      또는 IntelliJ 실행 구성의 Active profiles 에 local
# JWT 서명 키. application.yml 에는 기본값이 없어 여기서 줘야 서버가 뜹니다.
#
# 기본값을 두지 않는 이유는, 저장소에 있는 문자열로 서명하면 그걸 아는 누구나
# 아무 사용자의 토큰이든 위조할 수 있기 때문입니다. 로그인은 멀쩡히 동작해서
# 눈치채지 못합니다.
auth:
  jwt:
    # 32바이트 이상. 로컬 전용이라 아무 값이나 되지만, 운영 값을 여기 쓰지 마세요.
    secret: local-dev-secret-please-change-this-32bytes+

ai:
  base-url: http://localhost:8000

# 백엔드가 쓰는 카카오 값은 이 둘뿐입니다. REST API 키·네이티브 앱 키·JavaScript 키는
# 앱(클라이언트)이 로그인할 때 쓰는 것이라 서버에 넣지 않습니다.
kakao:
  # 앱 ID 는 숫자입니다 (32자리 키들과 헷갈리지 마세요). 콘솔 주소창의
  # /console/app/<숫자> 가 그 값입니다. 비밀값이 아닙니다.
  #
  # 없으면 서버가 뜨지 않습니다. 다른 앱에서 발급된 정상 카카오 토큰을 걸러내는
  # 유일한 방어선이라, 빠진 채로 뜨면 그게 통째로 꺼집니다.
  app-id: 여기에-앱-ID

  # Admin 키는 비밀값입니다. 탈퇴 시 연결 끊기(unlink)에만 씁니다.
  # 비워두면 unlink 를 건너뛰고 탈퇴 자체는 정상 동작합니다.
  admin-key: 여기에-어드민-키
