# 이 파일을 application-local.yml 로 복사해서 쓰세요. 복사본은 커밋되지 않습니다.
# 실행: ./gradlew bootRun --args='--spring.profiles.active=local'
#      또는 IntelliJ 실행 구성의 Active profiles 에 local
ai:
  base-url: http://localhost:8000
  internal-token: 로컬에서-쓸-토큰

# 카카오 개발자 콘솔 > 앱 설정 > 앱 키 페이지의 "앱 ID" 입니다.
# 없으면 서버가 뜨지 않습니다. 다른 앱에서 발급된 카카오 토큰을 걸러내는 값이라
# 빠진 채로 뜨면 그 방어선이 통째로 꺼집니다.
kakao:
  app-id: 여기에-앱-ID
  admin-key: 여기에-어드민-키
